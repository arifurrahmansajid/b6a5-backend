{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel-entry.ts",
      "use": "@vercel/node",
      "config": {
        "bundle": true,
        "includeFiles": "src/generated/prisma/**",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/vercel-entry.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}