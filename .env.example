# App
APP_NAME=Ummah Care
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:44fahadhasan@localhost:5432/ummahcare?schema=public

# Cookies
COOKIE_SECRET=your-cookie-secret

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# JWT
JWT_ACCESS_SECRET=your-access-secret
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_PATH=/api/auth/v1
BETTER_AUTH_COOKIE_PREFIX=ba
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=30d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d
BETTER_AUTH_SESSION_TOKEN_COOKIE_CACHE_AGE=300

# Email / SMTP
EMAIL_SENDER_SMTP_HOST=smtp.example.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_USER=your-email@example.com
EMAIL_SENDER_SMTP_PASS=your-email-password
EMAIL_SENDER_SMTP_SECURE=true
EMAIL_FROM=your-email@example.com

# Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=strong-password

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret